# ==============================================================================
# OPTION 1: GROQ + LOCAL HUGGINGFACE EMBEDDINGS (DEFAULT FREE SETUP)
# ==============================================================================
# Uses Groq's OpenAI-compatible API for fast LLM inference and runs embeddings 
# locally on your CPU via sentence-transformers (all-MiniLM-L6-v2).

GROQ_API_KEY=gsk_your_actual_groq_key_here
LLM_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=all-MiniLM-L6-v2


# ==============================================================================
# OPTION 2: STANDARD OPENAI / CHATGPT CONFIGURATION (OPTIONAL)
# ==============================================================================
# To use standard OpenAI instead of Groq:
# 1. Comment out GROQ_API_KEY and LLM_MODEL in Option 1 above (add '#' in front).
# 2. Uncomment the lines below and paste your OpenAI key (sk-...).

# OPENAI_API_KEY=sk-your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

# Uncomment below if you want to use OpenAI's cloud embeddings (text-embedding-3-small) 
# instead of the free local HuggingFace model.

# USE_OPENAI_EMBEDDINGS=true
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
